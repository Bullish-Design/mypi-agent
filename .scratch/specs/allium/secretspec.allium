-- allium: 3

-- SecretSpec setup specification for downstream consumers.
-- Ensures that SecretSpec is properly configured before the
-- scripts.pi wrapper attempts to inject secrets via `secretspec run`.
--
-- This spec describes the behaviour of a setup script that runs in
-- downstream repos (typically on shell entry or during `mypi sync`)
-- to verify and initialize the SecretSpec contract.

use "./core.allium" as core

-- The setup config lives at a .toml file in the project root.

entity SecretspecConfigFile {
    exists: Boolean
    path: String
    valid_toml: Boolean when exists
    has_profile_section: Boolean when valid_toml
    profiles: Set<String> when has_profile_section
    has_at_least_one_secret_key: Boolean when has_profile_section
}

-- The secretspec binary must be available on PATH.

entity SecretspecBinary {
    available: Boolean
    version: String when available
}

-- Whether required secrets are actually stored in the provider.

entity SecretspecProviderState {
    check_completed: Boolean
    all_secrets_set: Boolean when check_completed
    missing_secrets: Set<String> when check_completed and not all_secrets_set
}

-- The setup execution context.

entity SecretspecSetupRun {
    triggered: Boolean
    binary_checked: Boolean
    config_checked: Boolean
    config_created: Boolean
    check_performed: Boolean
    setup_completed: Boolean
    secrets_missing_warning_shown: Boolean
}

-- Downstream surface: the integration point for the setup script.

surface SecretspecSetupSurface {
    facing _: core/AgentRoot

    provides:
        SecretspecSetupRequested()
}

-- Rule 1: Verify the secretspec binary is available.

rule VerifySecretspecBinary {
    when: SecretspecSetupRequested()
    ensures: SecretspecSetupRun.binary_checked = true
    ensures: if SecretspecBinary.available:
        SecretspecBinary.version derived from secretspec --version
    @guidance
        -- Run: command -v secretspec
        -- If not found, emit a warning (not an error, since SecretSpec
        -- is optional — the mypi doctor also warns).
        -- In downstream repos, secretspec is provided via Nix:
        --   pkgs.secretspec added to devenv.nix packages.
}

-- Rule 2: Check if secretspec.toml exists. If missing, initialize it.

rule CheckSecretspecConfig {
    when: SecretspecSetupRequested()
    ensures: SecretspecSetupRun.config_checked = true
    ensures: SecretspecConfigFile.exists = true
    @guidance
        -- Check for secretspec.toml in the project root.
        -- If not found, run: secretspec init
        -- This creates secretspec.toml with default structure.
        -- The init command walks up directories to find the project root.
}

-- Rule 3: If config was missing, note that it was created.

rule CreateSecretspecConfig {
    when: SecretspecSetupRequested()
    requires: not SecretspecConfigFile.exists
    ensures: SecretspecConfigFile.exists = true
    ensures: SecretspecSetupRun.config_created = true
    @guidance
        -- Run: secretspec init
        -- After init, the config file will be at the project root.
        -- secretspec init creates an empty profile section.
        -- The user may need to add secret keys for the expected
        -- provider (see Rule 6 guidance for provider config).
}

-- Rule 4: Validate the config has a profile section with secret keys.

rule ValidateConfigStructure {
    when: SecretspecConfigFile.exists
    ensures: SecretspecConfigFile.valid_toml = true
    ensures: SecretspecConfigFile.has_profile_section
        = SecretspecConfigFile has a [profiles.*] table
    ensures: SecretspecConfigFile.has_at_least_one_secret_key
        = SecretspecConfigFile.has_profile_section
          and secretspec.toml contains at least one secret key
          under a [profiles.*] table
    @guidance
        -- Parse secretspec.toml to check structure.
        -- A valid config has at least one [profiles.default] section
        -- with at least one secret key entry like:
        --   ANTHROPIC_API_KEY = { description = "...", required = false }
        -- The mypi-agent project ships with a template config
        -- containing API keys for common providers.
}

-- Rule 5: Run secretspec check to verify secrets are in the provider.

rule CheckSecretsInProvider {
    when: SecretspecConfigFile.valid_toml
    requires: SecretspecConfigFile.has_profile_section
    requires: SecretspecBinary.available
    ensures: SecretspecSetupRun.check_performed = true
    ensures: SecretspecProviderState.check_completed = true
    ensures: SecretspecProviderState.all_secrets_set
        = secretspec check --no-prompt exits 0
    ensures: if not SecretspecProviderState.all_secrets_set:
        SecretspecSetupRun.secrets_missing_warning_shown = true
    @guidance
        -- Run: secretspec check --no-prompt
        -- --no-prompt avoids interactive prompts in automated flow.
        -- If check exits non-zero, some secrets are not yet stored
        -- in the provider. Show a message like:
        --   "SecretSpec: some secrets are not yet configured.
        --    Run: secretspec check"
        -- to guide the user.
}

-- Rule 6: If config exists but has no secrets defined, guide user.

rule GuideUserToAddSecrets {
    when: SecretspecConfigFile.valid_toml
    requires: not SecretspecConfigFile.has_at_least_one_secret_key
    ensures: SecretspecSetupRun.secrets_missing_warning_shown = true
    @guidance
        -- The config exists but has no secret keys defined.
        -- Show a message like:
        --   "SecretSpec config exists but has no secrets defined.
        --    Add API keys to secretspec.toml under [profiles.default]:
        --      ANTHROPIC_API_KEY = { description = "...", required = false }
        --      OPENAI_API_KEY = { description = "...", required = false }
        --    Then run: secretspec set <KEY> --from-env <ENV_VAR>
        --    Or run: secretspec check
        --    to interactively set missing values."
}

-- Rule 7: Finalize setup.

rule FinalizeSecretspecSetup {
    when: SecretspecSetupRequested()
    ensures: SecretspecSetupRun.setup_completed = true
    @guidance
        -- The setup script exits cleanly. Warnings about missing
        -- secretspec binary or unconfigured secrets are printed
        -- but do not cause a non-zero exit (secrets are optional).
        -- The actual runtime failure path is in scripts.pi:
        -- if secretspec is missing or unconfigured, the pi wrapper
        -- will fail at point of use, not at shell entry.
}

-- Invariant: setup does not fail on missing binary.

invariant MissingBinaryIsNonFatal {
    SecretspecSetupRun.setup_completed implies
        SecretspecSetupRun.binary_checked
    -- The setup script always completes, even if binary is missing
}

-- Invariant: secrets are checked without interactive prompts.

invariant CheckIsNonInteractive {
    SecretspecSetupRun.check_performed implies
        SecretspecProviderState.check_completed
    -- secretspec check --no-prompt never prompts
}

-- Invariant: config creation does not overwrite existing config.

invariant ExistingConfigIsPreserved {
    SecretspecConfigFile.exists and not SecretspecSetupRun.config_created
    -- init is only run when the config file does not yet exist
}
